# ==============================================================================
# GarmentOS Cloud Web Application (Frontend) Environment Configuration
# ==============================================================================

# API Base URL (defaults to '/api/v1' via Vite dev server proxy or production reverse proxy)
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Application Identity & Branding
VITE_APP_NAME="GarmentOS Cloud"
VITE_DEFAULT_LANG=ar

# Domain Architecture References (Local Dev / Production Mapping)
# Local Development:
# - Public Marketing Website: http://localhost:5173/ or http://garmentos.local:5173/
# - Dedicated App / Login:    http://localhost:5173/#/app or http://app.garmentos.local:5173/
# - Tenant Storefronts:        http://localhost:5173/#/store/{tenantSlug} or http://{tenantSlug}.garmentos.local:5173/
# - Customer Order Tracking:   http://localhost:5173/#/store/track
#
# Production Deployment:
# - Public Marketing Website: https://garmentos.com/
# - Dedicated App / Login:    https://app.garmentos.com/
# - API Gateway:              https://api.garmentos.com/v1
# - Tenant Storefronts:        https://{tenantSlug}.garmentos.com/ or https://garmentos.com/store/{tenantSlug}
VITE_PUBLIC_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173/#/app
